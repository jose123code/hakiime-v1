<!-- Start: 404 -->
    <main class="d-flex justify-content-center align-items-center py-5 min-vh-100">
        <div class="container">
            <div class="col-xl-4 col-lg-5 col-md-7 col-sm-9 mx-auto">
                <div class="nsofts-auth position-relative">
                    <img src="/assets/images/pattern-1.svg" class="nsofts-auth__pattern-1 position-absolute" alt="">
                    <img src="/assets/images/pattern-2.svg" class="nsofts-auth__pattern-2 position-absolute" alt="">
                    <div class="card position-relative">
                        <div class="card-body px-4 py-4">
                            
                            <form action="/auth/reset/{{data.token}}" method="POST">
                                <div class="mb-4">
                                    <h5>Reset password!</h5>
                                    <p>Enter your new password to get reset your account password.</p>
                                </div>

                                <div class="mb-3">
                                    <div class="nsofts-input-icon nsofts-input-icon--left">
                                        <label for="new_password" class="nsofts-input-icon__left">
                                            <i class="ri-lock-2-line"></i>
                                        </label>
                                        <input type="password" name="newPassword" id="new_password"  class="form-control" autocomplete="off" placeholder="New password " required>
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <div class="nsofts-input-icon nsofts-input-icon--left">
                                        <label for="confirm_password" class="nsofts-input-icon__left">
                                            <i class="ri-lock-2-line"></i>
                                        </label>
                                        <input type="password" name="confirmPassword" id="confirm_password"  class="form-control" autocomplete="off" placeholder="Confirm your password" required>
                                    </div>
                                </div>
                                
                                <div class="mb-3">
                                    <button  type="submit" name="submit" class="btn btn-primary btn-lg w-100">Reset</button>
                                </div>
                                
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>
    <!-- End: 404 -->

    <script type="text/javascript">


    window.load = () => {
        if(!{{success}}){
            var msgFinal = '';
            {{#if (isArray error)}}
                {{#each error}}
                    msgFinal += '{{this.msg}}\n';
                    {{!-- {{log this}} --}}
                {{/each}}
            {{else}}
                {{#if (isObject error)}}
                    msgFinal += '{{error.msg}}\n';
                    {{!-- {{log error}} --}}
                {{else}}
                    msgFinal += '{{error}}\n';
                    {{!-- console.log('{{error}}'); --}}
                {{/if}}
            {{/if}}

            

            $('.notifyjs-corner').empty();
            $.notify(msgFinal,{
                position: "top right",
                className:"error"
            });
        }
        
    }
</script>